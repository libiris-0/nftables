# Classify gateway traffic in two steps: destination address -> country -> class.
# geo4, geo6 and geoclass are filled externally, e.g. by nftables-geoip.
# meta priority holds the intermediate country ID.
table inet routing {
	map geo4 {
		type ipv4_addr : classid
		flags interval
	}

	map geo6 {
		type ipv6_addr : classid
		flags interval
	}

	map geoclass {
		type classid : classid
		flags interval
	}

	chain routing_select_classify {
		mark & $routing_mask != $routing_gateway return

		meta priority set 0x00000000
		meta priority set ip daddr map @geo4
		meta priority set ip6 daddr map @geo6
		meta priority set meta priority map @geoclass mark set mark & $routing_clear_mask | meta priority & $routing_mask
		meta priority set 0x00000000
	}
}

add rule inet routing routing_select jump routing_select_classify
